<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#29B6F6"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="70dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="↩"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="#3F6FEF"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share Profile"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2F6FEA"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learning Assistant Profile"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/shareProfileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username: Student"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <Button
            android:id="@+id/shareNowButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Share Now"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#69F56B" />

    </LinearLayout>

</ScrollView>